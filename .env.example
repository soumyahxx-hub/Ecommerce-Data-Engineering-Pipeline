# Copy to .env and edit. NEVER commit .env.
# Values below are LOCAL DEV defaults only (Docker Compose). Change them for anything else.

# --- Warehouse PostgreSQL (docker compose service "postgres") ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecom_dw
POSTGRES_USER=ecom
POSTGRES_PASSWORD=change_me_local_only

# --- Object storage: "s3" (local RustFS or AWS) or "local" (folder, no Docker needed) ---
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=ecom-lake
# RustFS root credentials: use a unique uppercase alphanumeric access key (no /).
AWS_ACCESS_KEY_ID=REPLACEWITHUNIQUEKEY
AWS_SECRET_ACCESS_KEY=change_me_rustfs_secret
AWS_DEFAULT_REGION=us-east-1
LOCAL_STORE_DIR=data/local_lake

# --- Pipeline ---
RAW_DATA_DIR=data/raw/olist
LOOKBACK_DAYS=7
DQ_MAX_REJECT_PCT=5
FRESHNESS_MAX_HOURS=26
FX_API_URL=https://api.frankfurter.dev/v1
HTTP_RETRIES=3

# --- Airflow (docker compose) ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_local_only
AIRFLOW_FERNET_KEY=
AIRFLOW_UID=50000

# --- OPTIONAL cloud (leave blank for local-only). Real AWS S3: clear S3_ENDPOINT_URL. ---
ENABLE_REDSHIFT=false
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DB=
REDSHIFT_USER=
REDSHIFT_PASSWORD=
REDSHIFT_IAM_ROLE_ARN=
